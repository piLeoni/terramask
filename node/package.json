{
  "name": "@pileoni/watermask",
  "version": "0.2.0",
  "description": "Water masks, shorelines and distance-to-shore grids for any area, from OpenStreetMap vector tiles fetched on demand",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi pre-publish -t npm",
    "build": "napi build --platform --release --manifest-path ../crates/watermask-node/Cargo.toml --package watermask-node --output-dir .",
    "build:debug": "napi build --platform --manifest-path ../crates/watermask-node/Cargo.toml --package watermask-node --output-dir .",
    "test": "node --test test.mjs"
  },
  "napi": {
    "binaryName": "watermask",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piLeoni/watermask.git"
  },
  "keywords": [
    "gis",
    "openstreetmap",
    "coastline",
    "water",
    "vector-tiles",
    "raster"
  ],
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  }
}
