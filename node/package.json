{
  "name": "@pileoni/terramask",
  "version": "0.1.2",
  "description": "Masks, outlines, polygons and distance grids of water, land, forests, parks or any OpenStreetMap layer, for any area, from vector tiles fetched on demand; depth and height bands from terrain tiles",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi pre-publish -t npm",
    "build": "napi build --platform --release --manifest-path ../crates/terramask-node/Cargo.toml --package terramask-node --output-dir .",
    "build:debug": "napi build --platform --manifest-path ../crates/terramask-node/Cargo.toml --package terramask-node --output-dir .",
    "test": "node --test test.mjs"
  },
  "napi": {
    "binaryName": "terramask",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piLeoni/terramask.git"
  },
  "keywords": [
    "gis",
    "openstreetmap",
    "coastline",
    "water",
    "land",
    "forest",
    "elevation",
    "bathymetry",
    "vector-tiles",
    "raster"
  ],
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  }
}
